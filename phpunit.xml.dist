<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Readme">
            <!-- Executes the samples of README.md that are marked as running, and runs the shared test set on the
                 example adapter the README shows. -->
            <directory>tests/Readme</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The leak tests print whole exception traces with their arguments, and those reach every test of the
             suite: the 128M of a plain PHP image no longer holds that. -->
        <ini name="memory_limit" value="1G"/>
        <!-- The leak tests search the traces of exceptions with the arguments of every call in them. A php.ini for
             production leaves those out; a host with PHP's own default shows them. -->
        <ini name="zend.exception_ignore_args" value="0"/>
        <!-- How many bytes of a string argument the string form of a trace shows. PHP's own default is 15; a
             php.ini for production sets 0, and a test that expects the first bytes of an argument there then
             fails. Set here so the suite sees the same on every machine. -->
        <ini name="zend.exception_string_param_max_len" value="15"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
